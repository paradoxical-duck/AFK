{
  "name": "afk",
  "productName": "AFK",
  "version": "1.0.0",
  "description": "AFK - privacy-first, fully-local AI speech-to-text for desktop.",
  "author": {
    "name": "pachisiav11"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env AFK_DEV=1 electron .",
    "setup:python": "node scripts/setup-python.js",
    "setup:clarify": "powershell -ExecutionPolicy Bypass -File scripts/setup-clarify.ps1",
    "rebuild": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg --arm64",
    "test": "node --test tests/electron/*.test.js"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.2"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "node-gyp-build": "^4.8.4",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.afk.app",
    "productName": "AFK",
    "executableName": "AFK",
    "compression": "store",
    "directories": {
      "output": "installer/dist",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "files": [
      "electron/**/*",
      "ui/**/*",
      "assets/**/*",
      "!**/__pycache__/**",
      "!**/*.pyc"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/venv/**",
          "!runtime/Lib/site-packages/bin/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "compression": "store",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AFK",
      "useZip": false
    }
  }
}
